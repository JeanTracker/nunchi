#!/bin/sh
# nunchi 실행기. 이 파일이 든 저장소의 .venv 파이썬으로 관제 TUI를 띄운다.
# ~/.local/bin/nunchi 는 이 파일을 가리키는 심볼릭 링크다 (install.sh --link).
set -e

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
py="$root/.venv/bin/python"

case ${1:-} in
  -h|--help)
    echo "사용법: nunchi            관제 화면 열기 (iTerm2 패널 안에서)"
    echo "       nunchi --where    설치 위치 보기"
    echo "설치·삭제: $root/install.sh --help"
    exit 0 ;;
  --where)
    echo "$root"
    exit 0 ;;
esac

if [ ! -x "$py" ]; then
  echo "nunchi: $py 가 없습니다. '$root/install.sh' 를 다시 실행하세요." >&2
  exit 1
fi

exec "$py" -m control_tui "$@"
